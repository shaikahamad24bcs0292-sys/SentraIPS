# =============================================================================
# SentraIPS Git Ignore Configuration
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend (Node / React / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editor & IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Runtime temporary uploads & logs
*.log
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep
